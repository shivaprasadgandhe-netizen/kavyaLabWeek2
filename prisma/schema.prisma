datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SecurityEventType {
  SIGN_IN
  SIGN_IN_BLOCKED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  ROLE_CHANGED
  SESSIONS_REVOKED
  DATA_EXPORTED
  ACCOUNT_DELETED
}

model User {
  id              String          @id @default(cuid())
  name            String?
  email           String?         @unique
  emailVerified   DateTime?
  image           String?
  role            Role            @default(USER)
  status          UserStatus      @default(ACTIVE)
  suspendedAt     DateTime?
  suspendedReason String?         @db.VarChar(200)
  lastSignedInAt  DateTime?
  accounts        Account[]
  sessions        Session[]
  securityEvents  SecurityEvent[]
  actorAuditLogs  AuditLog[]      @relation("ActorAuditLogs")
  targetAuditLogs AuditLog[]      @relation("TargetUserAuditLogs")

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model SecurityEvent {
  id        String            @id @default(cuid())
  userId    String?
  type      SecurityEventType
  ipHash    String?
  userAgent String?           @db.VarChar(255)
  createdAt DateTime          @default(now())

  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model RateLimit {
  key          String   @id
  count        Int
  windowEndsAt DateTime

  @@index([windowEndsAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  targetUserId String?
  oldRole      Role
  newRole      Role
  createdAt    DateTime @default(now())

  actor        User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser   User?    @relation("TargetUserAuditLogs", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetUserId])
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  userAgent    String?  @db.VarChar(255)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
